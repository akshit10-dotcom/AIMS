# ============================================
# AIMS Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file!
# ============================================

# Server port
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/schoolApp
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb://localhost:27017/schoolApp

# JWT secret - USE A LONG RANDOM STRING (min 32 chars recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# JWT token lifetime (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Gemini AI API key for AI quiz generation
# Get one at: https://aistudio.google.com/apikey
# If left empty, the app falls back to template-based quiz generation.
GEMINI_API_KEY=

# Teacher registration code
# If set, teachers must enter this code when registering.
# If left empty, anyone can register as a teacher (NOT recommended).
TEACHER_REGISTRATION_CODE=

# Allowed CORS origins (comma-separated).
# Add your frontend URLs here. For Capacitor Android builds, also include:
#   capacitor://localhost, https://localhost
CLIENT_ORIGIN=http://localhost:3000,capacitor://localhost,https://localhost

# Node environment (development | production)
NODE_ENV=development

