# ============================================
# AIMS Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file!
# ============================================

# Local server port. Production platforms usually assign PORT automatically.
PORT=5000

# MongoDB connection string (use a managed MongoDB service in production)
# Local: mongodb://localhost:27017/schoolApp
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>
MONGO_URI=

# JWT secret - use a unique random value of at least 32 characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT token lifetime (e.g. 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Gemini AI API key for AI quiz generation
# Get one at: https://aistudio.google.com/apikey
# If left empty, the app falls back to template-based quiz generation.
GEMINI_API_KEY=

# Teacher registration code (required in production)
# If set, teachers must enter this code when registering.
# In development, leaving it empty allows open teacher registration.
TEACHER_REGISTRATION_CODE=

# Allowed CORS origins (comma-separated).
# Set to your deployed frontend origin(s) in production (no trailing slash).
# For Capacitor Android builds, also include:
#   capacitor://localhost, https://localhost
CLIENT_ORIGIN=

# Optional: omit to use template-based quiz generation.
GEMINI_API_KEY=

# Node environment (development | production). Set to production when deployed.
NODE_ENV=development

