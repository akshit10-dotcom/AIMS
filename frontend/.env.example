# ============================================
# AIMS Frontend Environment Variables
# Copy this file to .env and adjust as needed.
# ============================================

# API base URL (embedded in the frontend at build time; it is not a secret).
# Local development:
# Web dev: http://localhost:5000
# Android emulator: http://10.0.2.2:5000
# Physical Android device: http://<your-computer-LAN-IP>:5000
# Production: set the deployed HTTPS API URL in the frontend host's build environment.
# Never put private API keys or other secrets in REACT_APP_* variables.
REACT_APP_API_URL=http://localhost:5000

